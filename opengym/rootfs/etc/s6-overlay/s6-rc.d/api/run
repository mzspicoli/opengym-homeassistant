#!/usr/bin/with-contenv bashio
# openGym's api/server.js, unchanged — options here map 1:1 to the env vars
# documented in the upstream repo's docs/SELF_HOSTING.md and .env.example.
set -e

export NODE_ENV=production
export PORT=3000
export DATA_DIR=/data
export RP_NAME="$(bashio::config 'rp_name')"

# Default to whatever address Home Assistant itself is already reachable at
# (Nabu Casa Remote UI, or your own external_url if you've set one) — no
# public_url needed for the common case. Requires homeassistant_api: true
# (see config.yaml) so bashio::api.supervisor can reach Core's own /api/config
# through the Supervisor proxy; HA_EXTERNAL_URL is "null" (the literal jq
# string, not empty) when nothing is configured there either — same
# guest-mode fallback as before in that case.
if bashio::config.has_value 'public_url'; then
    ORIGIN="$(bashio::config 'public_url')"
else
    ORIGIN="$(bashio::api.supervisor GET /core/api/config false '.external_url' 2>/dev/null || true)"
    [ "${ORIGIN}" = "null" ] && ORIGIN=""
fi

if [ -n "${ORIGIN}" ]; then
    export ORIGIN
    if bashio::config.has_value 'rp_id'; then
        export RP_ID="$(bashio::config 'rp_id')"
    else
        # WebAuthn's rp_id is the bare hostname only (no scheme/port/path) —
        # derive it from whichever ORIGIN was resolved above.
        export RP_ID="$(echo "${ORIGIN}" | sed -E 's#^[a-zA-Z]+://##; s#[/:].*##')"
    fi
fi

if bashio::config.has_value 'admin_uids'; then export ADMIN_UIDS="$(bashio::config 'admin_uids')"; fi
if bashio::config.true 'invite_only'; then export INVITE_ONLY=1; fi
if ! bashio::config.true 'allow_guest'; then export ALLOW_GUEST=0; fi
export SESSION_DAYS="$(bashio::config 'session_days')"

# Only set when MCP is actually running, so api/mcp-proxy.js's own "not enabled by
# this installation" 503 is what Settings → MCP / AI sees, rather than a
# connection-refused 502 to a service that was never started.
if bashio::config.true 'mcp_enabled'; then
    export MCP_INTERNAL_URL="http://127.0.0.1:3001"
fi

cd /opt/opengym/api
exec node server.js
